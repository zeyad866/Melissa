      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1220, 300],
      "id": "master-node-07"
    },
    {
      "parameters": {
        "jsCode": "// Generate final end-to-end run report\nconst results = $input.all().map(item => item.json);\n\nreturn [{\n  json: {\n    pipeline_status: 'SUCCESS',\n    completed_at: new Date().toISOString(),\n    total_applications_processed: results.length,\n    application_details: results\n  }\n}];"
      },
      "name": "Final Run Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 300],
      "id": "master-node-08"
    }
