      "id": "master-node-04"
    },
    {
      "parameters": {
        "jsCode": "// Filter ranked jobs to only those with decision === 'APPLY'\nconst rankedList = $input.first().json;\nconst applyJobs = (rankedList || []).filter(job => job.decision === 'APPLY');\n\nif (applyJobs.length === 0) {\n  return [{ json: { message: 'No jobs qualified for APPLY decision.', total_ranked: rankedList.length, applications: [] } }];\n}\n\nreturn applyJobs.map(job => ({ json: job }));"
      },
      "name": "Filter APPLY Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300],
      "id": "master-node-05"
    },
    {
      "parameters": {
        "workflowId": "module-4-workflow-id",
        "options": {}
      },
