{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApplicationStatusPayload",
  "description": "Interface Contract 3.5: Final Output of Module 5 (Application & Tracking)",
  "type": "object",
  "required": [
    "schema_version",
    "application_id",
    "candidate_id",
    "job_id",
    "company",
    "job_title",
    "approval_decision",
    "application_status",
    "submission_method",
    "submitted_at",
    "attempts",
    "confirmation_sent"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "application_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "approval_decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "REVIEW"]
    },
    "application_status": {
      "type": "string",
      "enum": ["submitted", "failed", "skipped_duplicate", "pending_approval"]
    },
    "submission_method": {
      "type": "string",
      "enum": ["api", "email", "mock", "manual"]
    },
    "submitted_at": {
      "type": ["string", "null"]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "confirmation_sent": {
      "type": "boolean"
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "stage": { "type": "string" }
      },
      "required": ["code", "message", "stage"]
    }
  },
  "additionalProperties": false
}
