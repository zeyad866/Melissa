{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CandidateProfilePayload",
  "description": "Interface Contract 3.1: Output of Module 1 (CV Intelligence) consumed by Module 3 (Matching & Ranking)",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_name",
    "email",
    "experience_years",
    "job_titles",
    "preferred_roles",
    "technical_skills",
    "programming_languages",
    "frameworks",
    "tools",
    "keywords",
    "education",
    "extraction_meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "candidate_id": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": ["string", "null"]
    },
    "location": {
      "type": ["string", "null"]
    },
    "experience_years": {
      "type": "number",
      "minimum": 0
    },
    "job_titles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preferred_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "technical_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "programming_languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "frameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Market-facing search terms used by Module 2"
    },
    "soft_skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "certifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "field", "institution", "year"],
        "properties": {
          "degree": { "type": "string" },
          "field": { "type": "string" },
          "institution": { "type": "string" },
          "year": { "type": ["integer", "string"] }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "technologies"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "technologies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "extraction_meta": {
      "type": "object",
      "required": ["model", "prompt_version", "extracted_at", "confidence"],
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
