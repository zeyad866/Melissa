{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobsListPayload",
  "description": "Interface Contract 3.2: Output of Module 2 (Job Discovery) consumed by Module 3 (Matching & Ranking)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "schema_version",
      "job_id",
      "job_title",
      "company",
      "location",
      "source",
      "description",
      "application_url",
      "required_skills",
      "retrieved_at"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
      },
      "job_id": {
        "type": "string"
      },
      "job_title": {
        "type": "string"
      },
      "company": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "application_url": {
        "type": "string",
        "format": "uri"
      },
      "required_skills": {
        "type": "array",
        "items": { "type": "string" }
      },
      "preferred_skills": {
        "type": "array",
        "items": { "type": "string" }
      },
      "technologies": {
        "type": "array",
        "items": { "type": "string" }
      },
      "employment_type": {
        "type": ["string", "null"]
      },
      "seniority_level": {
        "type": ["string", "null"]
      },
      "salary": {
        "type": ["string", "null"]
      },
      "education_requirement": {
        "type": ["string", "null"]
      },
      "required_experience_years": {
        "type": ["number", "null"]
      },
      "retrieved_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false
  }
}
